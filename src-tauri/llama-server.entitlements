<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The cleanup sidecar loads its own llama.cpp dylibs from Contents/MacOS.
         Under the hardened runtime a self-signed build has no Team ID, and
         library validation then refuses every dylib ("mapping process and
         mapped file (non-platform) have different Team IDs"). Only the
         sidecar gets this; Voce itself keeps library validation. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
